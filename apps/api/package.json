{
  "name": "@gym/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "esbuild src/main/index.ts --bundle --platform=node --format=esm --target=node22 --external:zod --external:graphql --external:graphql-yoga --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@gym/graphql-schema": "workspace:*",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.1.0",
    "zod": "^4.6.7"
  }
}
