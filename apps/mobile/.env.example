# Copy to .env for local work. Build service builds (internal and production) read
# these from the build service environment, never from the repo. Do not commit real
# values for signing keys, secrets or tokens.
# An Android emulator reaches the host machine at 10.0.2.2.
BUILD_PROFILE=development
API_URL=http://localhost:3000/graphql
# Required for the internal and production profiles, optional in development.
# GOOGLE_IOS_CLIENT_ID=<ios client id>.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=<android client id>.apps.googleusercontent.com
