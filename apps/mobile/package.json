{
  "name": "@gym/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**/*.{ts,tsx}' --coverage.exclude='**/*.test.ts' --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90"
  },
  "dependencies": {
    "@gym/graphql-schema": "workspace:*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "expo": "^58.0.25",
    "expo-brightness": "^58.0.3",
    "expo-constants": "~58.0.16",
    "expo-secure-store": "^58.0.3",
    "expo-status-bar": "~58.0.5",
    "graphql": "^17.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "jsdom": "^31.0.1",
    "react-dom": "19.3.0",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
